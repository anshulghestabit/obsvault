meta {
  name: Pagination
  type: http
  seq: 10
}

get {
  url: http://localhost:3000/api/v1/products?page=1&limit=10
  body: none
  auth: none
}

params:query {
  page: 1
  limit: 10
}

docs {
  Paginate through products.
  
  Parameters:
  - page: Page number (default: 1)
  - limit: Items per page (default: 10)
  
  Response includes:
  {
    "status": "success",
    "results": 10,           // Items in current page
    "total": 145,            // Total items in database
    "page": 1,               // Current page
    "totalPages": 15,        // Total number of pages
    "data": [...]            // Array of products
  }
  
  Examples:
  ?page=1&limit=10   → First 10 items
  ?page=2&limit=20   → Items 21-40
  ?page=3&limit=5    → Items 11-15
  
  Try changing page and limit values!
}
