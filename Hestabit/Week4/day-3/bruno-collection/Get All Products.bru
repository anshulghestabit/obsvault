meta {
  name: Get All Products
  type: http
  seq: 1
}

get {
  url: http://localhost:3000/api/v1/products
  body: none
  auth: none
}

docs {
  Get all products with optional query parameters:
  
  Available query options:
  - search: Search in name/description (e.g., ?search=laptop)
  - category: Filter by category (e.g., ?category=electronics)
  - price[gte]: Price >= value
  - price[lte]: Price <= value
  - price[gt]: Price > value
  - price[lt]: Price < value
  - sort: Sort by field (e.g., ?sort=-price for descending)
  - page: Page number (default: 1)
  - limit: Items per page (default: 10)
  - fields: Select specific fields (e.g., ?fields=name,price)
  
  Examples:
  ?search=laptop
  ?category=electronics&price[gte]=500
  ?sort=-price&page=1&limit=20
}
