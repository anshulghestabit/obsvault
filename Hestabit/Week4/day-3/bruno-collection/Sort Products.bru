meta {
  name: Sort Products
  type: http
  seq: 9
}

get {
  url: http://localhost:3000/api/v1/products?sort=-price
  body: none
  auth: none
}

params:query {
  sort: -price
}

docs {
  Sort products by one or more fields.
  
  Syntax:
  - field name = ascending order (e.g., price)
  - -field name = descending order (e.g., -price)
  - Multiple fields = separate with comma (e.g., category,-price)
  
  Examples:
  ?sort=price          → Price low to high
  ?sort=-price         → Price high to low
  ?sort=category,-price → By category (A-Z), then price (high to low)
  ?sort=name           → Alphabetically by name
  
  Default: -createdAt (newest first)
  
  Try changing the sort value!
}
