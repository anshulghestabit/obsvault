meta {
  name: Update Product
  type: http
  seq: 4
}

patch {
  url: http://localhost:3000/api/v1/products/PRODUCT_ID_HERE
  body: json
  auth: none
}

body:json {
  {
    "price": 2299,
    "stock": 30
  }
}

docs {
  Update a product by ID.
  
  Instructions:
  1. Get a product _id from "Get All Products"
  2. Replace PRODUCT_ID_HERE with the actual _id
  3. Modify the JSON body with fields you want to update
  
  You can update any field:
  - name
  - price
  - description
  - category
  - stock
  
  Response: Returns the updated product
}
