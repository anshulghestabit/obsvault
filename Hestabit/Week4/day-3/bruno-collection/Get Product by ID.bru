meta {
  name: Get Product by ID
  type: http
  seq: 3
}

get {
  url: http://localhost:3000/api/v1/products/PRODUCT_ID_HERE
  body: none
  auth: none
}

docs {
  Get a single product by its MongoDB _id.
  
  Instructions:
  1. First run "Get All Products" or "Create Product"
  2. Copy a product _id from the response
  3. Replace PRODUCT_ID_HERE in the URL with the actual _id
  4. Send the request
  
  Response: Returns single product or 404 error
}
